# Copy this file to `.env.local` (ignored by git) and fill in your values.
# Find them in the Supabase dashboard: Project Settings → API Keys.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Use the *publishable* key here. NEVER put the secret / service_role key
# in a VITE_ variable: everything in the client is public.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
